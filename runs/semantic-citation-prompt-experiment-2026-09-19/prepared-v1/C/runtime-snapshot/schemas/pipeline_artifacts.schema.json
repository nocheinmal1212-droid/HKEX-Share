{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "annotation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "annotation_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "method": {
          "enum": [
            "code",
            "model",
            "reviewed_fixture"
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dimension": {
                "enum": [
                  "concept",
                  "role",
                  "entity",
                  "scope",
                  "period_kind",
                  "period",
                  "currency",
                  "scale",
                  "presentation_basis"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "support_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "dimension",
              "label",
              "support_refs"
            ],
            "additionalProperties": false
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "target_id": {
                "type": "string",
                "minLength": 1
              },
              "support_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "role",
              "target_id",
              "support_refs"
            ],
            "additionalProperties": false
          }
        },
        "state": {
          "enum": [
            "resolved",
            "ambiguous",
            "missing_evidence",
            "invalid_extraction"
          ]
        }
      },
      "required": [
        "schema_version",
        "doc_id",
        "variant_id",
        "annotation_id",
        "evidence_refs",
        "method",
        "labels",
        "links",
        "state"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "annotation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "operation": {
          "enum": [
            "signed_sum",
            "equality"
          ]
        },
        "operands": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "coefficient": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
                "maxLength": 1000
              }
            },
            "required": [
              "evidence_id",
              "coefficient"
            ],
            "additionalProperties": false
          }
        },
        "context_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "justification_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completeness": {
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ]
        },
        "tolerance_policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "doc_id",
        "variant_id",
        "plan_id",
        "evidence_refs",
        "annotation_refs",
        "operation",
        "operands",
        "context_requirements",
        "justification_refs",
        "completeness",
        "tolerance_policy"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "opportunity_id": {
          "type": "string",
          "minLength": 1
        },
        "category_code": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "object",
          "properties": {
            "page_index": {
              "type": "integer",
              "minimum": 0
            },
            "table_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "section_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "row_key": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "column_key": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "page_index",
            "table_id",
            "section_id",
            "row_key",
            "column_key"
          ],
          "additionalProperties": false
        },
        "plan_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "passed",
            "failed",
            "abstained",
            "not_applicable",
            "crashed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schema_version",
        "doc_id",
        "variant_id",
        "check_id",
        "opportunity_id",
        "category_code",
        "location",
        "plan_id",
        "state",
        "reason",
        "evidence_refs",
        "finding_ids"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "plan_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "category_code": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "object",
          "properties": {
            "page_index": {
              "type": "integer",
              "minimum": 0
            },
            "table_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "section_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "row_key": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "column_key": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "page_index",
            "table_id",
            "section_id",
            "row_key",
            "column_key"
          ],
          "additionalProperties": false
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claim": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "numerical",
                "token",
                "reference"
              ]
            },
            "operand_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "span_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "evidence_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "evidence_id",
                  "start",
                  "end"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "operand_refs",
            "span_refs"
          ],
          "additionalProperties": false
        },
        "calculation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "residual": {
                  "type": "string",
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
                  "maxLength": 1000
                },
                "tolerance": {
                  "type": "string",
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
                  "maxLength": 1000
                },
                "policy": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "residual",
                "tolerance",
                "policy"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "doc_id",
        "variant_id",
        "finding_id",
        "check_id",
        "plan_id",
        "category_code",
        "location",
        "evidence_refs",
        "claim",
        "calculation"
      ],
      "additionalProperties": false
    },
    "stage_failure": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "stage": {
          "enum": [
            "selection",
            "adapter",
            "consumer"
          ]
        },
        "state": {
          "const": "crashed"
        },
        "error_type": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "stage",
        "state",
        "error_type",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}

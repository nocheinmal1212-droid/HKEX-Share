{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "intake_grouping",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision_reason": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "locations_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sites",
          "reason"
        ]
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "prior_exposure": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "enum": [
        "reviewed_connections",
        "conservative_bundle"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "revision",
    "predecessor",
    "revision_reason",
    "manifest_sha256",
    "locations_sha256",
    "sites",
    "edges",
    "unresolved",
    "reviewer",
    "reviewed_at",
    "prior_exposure",
    "strategy",
    "rationale"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "mode": {
          "const": "native"
        },
        "document": {
          "type": "object",
          "properties": {
            "doc_id": {
              "type": "string",
              "minLength": 1
            },
            "variant_id": {
              "type": "string",
              "minLength": 1
            },
            "source_document_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_provenance": {
              "enum": [
                "supplied_unverified",
                "synthetic"
              ]
            }
          },
          "required": [
            "doc_id",
            "variant_id",
            "source_document_sha256",
            "source_provenance"
          ],
          "additionalProperties": false
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "const": "middle_json"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "role",
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "mode",
        "document",
        "artifacts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "mode": {
          "const": "ir"
        },
        "document": {
          "type": "object",
          "properties": {
            "doc_id": {
              "type": "string",
              "minLength": 1
            },
            "variant_id": {
              "type": "string",
              "minLength": 1
            },
            "source_document_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_provenance": {
              "enum": [
                "supplied_unverified",
                "synthetic"
              ]
            }
          },
          "required": [
            "doc_id",
            "variant_id",
            "source_document_sha256",
            "source_provenance"
          ],
          "additionalProperties": false
        },
        "evidence": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "manifest": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "mode",
        "document",
        "evidence",
        "manifest"
      ],
      "additionalProperties": false
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "error_record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "error_id": {
      "type": "string",
      "minLength": 1
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "variant_id": {
      "type": "string",
      "minLength": 1
    },
    "doc_id": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "original_record_id": {
          "type": "string",
          "minLength": 1
        },
        "line_number": {
          "type": "integer",
          "minimum": 1
        },
        "original_taxonomy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer"
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "version",
            "revision",
            "scope"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "original_record_id",
        "line_number",
        "original_taxonomy"
      ]
    },
    "status": {
      "enum": [
        "active",
        "retired"
      ]
    },
    "ingestion_status": {
      "enum": [
        "pending",
        "ready"
      ]
    },
    "category_code": {
      "type": "string",
      "minLength": 1
    },
    "category_revision": {
      "type": "integer",
      "minimum": 1
    },
    "scoring_status": {
      "enum": [
        "scored",
        "descoped"
      ]
    },
    "site_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "split_group_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "split": {
      "anyOf": [
        {
          "enum": [
            "dev",
            "test"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/location"
        },
        {
          "type": "null"
        }
      ]
    },
    "secondary_locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "original_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "injected_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "original_value": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "injected_value": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "value_delta": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "relation": {
      "anyOf": [
        {
          "$ref": "#/$defs/relation"
        },
        {
          "type": "null"
        }
      ]
    },
    "detectability_band": {
      "enum": [
        "above_tolerance",
        "boundary",
        "within_tolerance",
        "not_applicable",
        "unknown"
      ]
    },
    "expected_detectable": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "injection_stage": {
      "enum": [
        "pre_ocr_pdf",
        "post_ocr_ir",
        "post_ocr_markdown",
        "unknown"
      ]
    },
    "injector_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "propagated": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "propagation_sites": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "review_notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review_note"
      }
    },
    "created_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "error_id",
    "bundle_id",
    "variant_id",
    "doc_id",
    "source_ref",
    "status",
    "ingestion_status",
    "category_code",
    "category_revision",
    "scoring_status",
    "site_id",
    "split_group_id",
    "split",
    "location",
    "secondary_locations",
    "original_text",
    "injected_text",
    "original_value",
    "injected_value",
    "value_delta",
    "relation",
    "detectability_band",
    "expected_detectable",
    "injection_stage",
    "injector_version",
    "seed",
    "propagated",
    "propagation_sites",
    "description",
    "review_notes",
    "created_at",
    "updated_at"
  ],
  "$defs": {
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pointer": {
          "type": "string",
          "minLength": 1
        },
        "rectangle": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifact_path",
        "sha256",
        "pointer",
        "rectangle"
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page_index": {
          "type": "integer",
          "minimum": 0
        },
        "table_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "row_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "column_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anchor"
          }
        },
        "corrupted_endpoint": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "page_index",
        "table_id",
        "section_id",
        "row_key",
        "column_key",
        "source_anchors",
        "corrupted_endpoint"
      ],
      "anyOf": [
        {
          "properties": {
            "table_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "section_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "review_note": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "field",
        "reason",
        "reviewer",
        "reviewed_at",
        "evidence_refs"
      ]
    },
    "operand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operand_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "contributor",
            "total"
          ]
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "coefficient": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "maxLength": 1000
        },
        "scale": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "maxLength": 1000
        },
        "original_text": {
          "type": "string"
        },
        "injected_text": {
          "type": "string"
        },
        "original_value": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "maxLength": 1000
        },
        "injected_value": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "maxLength": 1000
        },
        "rounding_step": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "maxLength": 1000
        }
      },
      "required": [
        "operand_id",
        "role",
        "location",
        "coefficient",
        "scale",
        "original_text",
        "injected_text",
        "original_value",
        "injected_value",
        "rounding_step"
      ]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "signed_sum"
          ]
        },
        "complete": {
          "const": true
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "concept": {
              "type": "string",
              "minLength": 1
            },
            "entity": {
              "type": "string",
              "minLength": 1
            },
            "period": {
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "presentation_basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "concept",
            "entity",
            "period",
            "unit",
            "presentation_basis"
          ]
        },
        "operands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operand"
          },
          "minItems": 2
        },
        "rounding_policy": {
          "enum": [
            "independent_nearest"
          ]
        },
        "original_residual": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "maxLength": 1000
        },
        "injected_residual": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "maxLength": 1000
        },
        "tolerance_bound": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "maxLength": 1000
        },
        "residual_change": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "maxLength": 1000
        }
      },
      "required": [
        "relation_id",
        "operation",
        "complete",
        "context",
        "operands",
        "rounding_policy",
        "original_residual",
        "injected_residual",
        "tolerance_bound",
        "residual_change"
      ]
    }
  }
}

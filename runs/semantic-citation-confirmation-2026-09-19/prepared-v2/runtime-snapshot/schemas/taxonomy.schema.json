{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit discrepancy vocabulary, version 2",
  "description": "Runtime-safe category vocabulary. Scoring scope and check capabilities are defined separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "taxonomy_version",
    "categories"
  ],
  "properties": {
    "spec_version": {
      "const": "2.0.0"
    },
    "taxonomy_version": {
      "const": "2.0.0"
    },
    "categories": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/category"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "primary_statement_articulation"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "internal_note_reconciliation"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "statement_to_note_articulation"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "disclosure_reference_verification"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "document_wide_consistency"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "formatting_typography_validation"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "inter_note_articulation"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "table_structural_integrity"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "textual_semantic_integrity"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "revision",
        "name",
        "status",
        "scope",
        "description"
      ],
      "properties": {
        "code": {
          "enum": [
            "primary_statement_articulation",
            "internal_note_reconciliation",
            "statement_to_note_articulation",
            "disclosure_reference_verification",
            "document_wide_consistency",
            "formatting_typography_validation",
            "inter_note_articulation",
            "table_structural_integrity",
            "textual_semantic_integrity"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "status": {
          "const": "active"
        },
        "scope": {
          "enum": [
            "financial_statements",
            "single_note",
            "cross_statement_and_notes",
            "cross_references",
            "global",
            "presentation",
            "cross_notes",
            "tables",
            "narrative"
          ]
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "primary_statement_articulation"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "const": "financial_statements"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "internal_note_reconciliation"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "const": "single_note"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "statement_to_note_articulation"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "const": "cross_statement_and_notes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "disclosure_reference_verification"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "const": "cross_references"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "document_wide_consistency"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "const": "global"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "formatting_typography_validation"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "const": "presentation"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "inter_note_articulation"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "const": "cross_notes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "table_structural_integrity"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "const": "tables"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "textual_semantic_integrity"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "const": "narrative"
              }
            }
          }
        }
      ]
    }
  }
}

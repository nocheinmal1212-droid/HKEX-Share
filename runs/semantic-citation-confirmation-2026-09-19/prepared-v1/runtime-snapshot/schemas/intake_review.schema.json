{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "intake_review",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision_reason": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "locations_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "split_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "approve",
              "pending"
            ]
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "record_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "error_id",
          "decision",
          "reviewer",
          "reviewed_at",
          "rationale",
          "record_sha256"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "revision",
    "predecessor",
    "revision_reason",
    "manifest_sha256",
    "locations_sha256",
    "split_sha256",
    "owner",
    "decisions"
  ]
}

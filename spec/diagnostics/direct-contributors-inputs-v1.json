{
  "operation": "select_direct_addends",
  "status": "proposal_only_no_dispatcher_or_live_execution",
  "purpose": "Identify the nearest explicitly supported additive children of one stated expense total; do not flatten nested subtotals or add memo rows.",
  "model": "deepseek/deepseek-v4-pro-0813",
  "output_keys": [
    "action",
    "target_id",
    "contributor_ids",
    "support_ids",
    "reason"
  ],
  "action_vocabulary": [
    "select",
    "abstain"
  ],
  "reason_vocabulary": [
    "supported_direct_breakdown",
    "missing_evidence",
    "ambiguous_relationship",
    "incompatible_context",
    "unknown_context"
  ],
  "output_rules": [
    "target_id must equal the typed target on every model output, including abstention.",
    "For select, contributor_ids is a nonempty unique subset of candidate_ids excluding target_id.",
    "For abstain, contributor_ids is empty. Never substitute a different target.",
    "support_ids are unique IDs from selected evidence; selection must cite the relationship note and the target/contributor header bindings needed for its claim.",
    "Return only the five keys with IDs and permitted labels; no amounts, arithmetic, coefficients, corrected values, explanations or generated code.",
    "Selected contributor IDs are an unordered set for semantic grading; do not repair unknown IDs or normalize their spelling.",
    "A selected relationship is not an arithmetic pass or proof of semantic correctness."
  ],
  "evidence_rules": [
    "Items and header associations here are hand-authored synthetic evidence, not generated annotations or a validated production IR.",
    "Interpret the literal relationship note and row/header labels. Missing source evidence and ambiguous directness abstain.",
    "Do not infer accounting completeness from a rectangular grid or absence of a limitation.",
    "Incompatible or ambiguous candidate/target contexts block the proposed direct relationship.",
    "The same shared unknown currency/scale does not alone block explicit local role selection; arithmetic and conversion prerequisites remain unresolved downstream.",
    "Incomplete evidence elsewhere does not block a locally supported relationship."
  ],
  "execution": {
    "inference_calls": 0,
    "production_dispatch": false,
    "retries": 0,
    "provider": null,
    "live_token_budget": null
  },

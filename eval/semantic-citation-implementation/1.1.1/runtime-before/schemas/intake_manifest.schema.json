{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "intake_manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision_reason": {
      "type": "string",
      "minLength": 1
    },
    "source_config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "variant_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "role",
          "variant_id"
        ]
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "variant_id": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "tree_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "engine": {
            "type": "string",
            "minLength": 1
          },
          "backend": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "checkpoint": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "settings": {
            "type": [
              "object",
              "null"
            ]
          },
          "page_count": {
            "type": "integer",
            "minimum": 0
          },
          "supplied_pdf": {
            "type": "string",
            "minLength": 1
          },
          "origin_pdf": {
            "type": "string",
            "minLength": 1
          },
          "correspondence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "verified"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "reason"
            ]
          }
        },
        "required": [
          "variant_id",
          "root",
          "tree_sha256",
          "engine",
          "backend",
          "version",
          "checkpoint",
          "settings",
          "page_count",
          "supplied_pdf",
          "origin_pdf",
          "correspondence"
        ]
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "revision",
    "predecessor",
    "revision_reason",
    "source_config_sha256",
    "files",
    "exports",
    "owner",
    "limitations"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "identity_policy": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "document": {
      "type": "object",
      "properties": {
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "source_document_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_provenance": {
          "enum": [
            "supplied_unverified",
            "synthetic"
          ]
        }
      },
      "required": [
        "doc_id",
        "variant_id",
        "source_document_sha256",
        "source_provenance"
      ],
      "additionalProperties": false
    },
    "artifact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "page_index": {
            "type": "integer",
            "minimum": 0
          },
          "native_pointer": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "height": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "coordinate_frame": {
            "const": "native_page"
          },
          "units": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "origin": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "rotation": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "coordinate_reason": {
            "type": "string",
            "minLength": 1
          },
          "printed_label_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "page_index",
          "native_pointer",
          "width",
          "height",
          "coordinate_frame",
          "units",
          "origin",
          "rotation",
          "coordinate_reason",
          "printed_label_refs"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "block",
              "table",
              "cell",
              "description",
              "formula",
              "figure"
            ]
          },
          "page_index": {
            "type": "integer",
            "minimum": 0
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "native_pointer": {
            "type": "string",
            "minLength": 1
          },
          "ordinal": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "native_type": {
            "type": "string"
          },
          "native_index": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "native_angle": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "merge_hint": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "bbox": {
            "anyOf": [
              {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 4
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "fragments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                },
                "encoding": {
                  "enum": [
                    "literal",
                    "html_entity"
                  ]
                }
              },
              "required": [
                "source_id",
                "start",
                "end",
                "encoding"
              ],
              "additionalProperties": false
            }
          },
          "content_state": {
            "enum": [
              "text",
              "blank",
              "missing",
              "unsupported"
            ]
          },
          "row": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "column": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "row_span": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "column_span": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "row_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "column_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "grid_state": {
            "anyOf": [
              {
                "enum": [
                  "resolved",
                  "partial",
                  "unresolved"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "source_span": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "source_id",
                  "start",
                  "end"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "page_index",
          "parent_id",
          "native_pointer",
          "ordinal",
          "native_type",
          "native_index",
          "native_angle",
          "merge_hint",
          "bbox",
          "text",
          "fragments",
          "content_state",
          "row",
          "column",
          "row_span",
          "column_span",
          "row_count",
          "column_count",
          "grid_state",
          "source_span"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "enum": [
              "text",
              "html",
              "json"
            ]
          },
          "text": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "artifact_id",
          "pointer",
          "format",
          "text",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "scope_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "available",
              "unavailable",
              "unknown"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "name",
          "scope_id",
          "state",
          "reason",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "region_id": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "region_id",
          "code",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "identity_policy",
    "id",
    "document",
    "artifact_ids",
    "pages",
    "nodes",
    "sources",
    "capabilities",
    "limitations"
  ],
  "additionalProperties": false
}
